 "lyrics": [
  {
   "section": "Verse 1",
   "text": "My mind dey pack bag",
   "start": 18.93,
   "end": 21.15
  },
  {
   "section": "Verse 1",
   "text": "Before trouble land",
   "start": 21.15,
   "end": 23.59
  },
  {
   "section": "Verse 1",
   "text": "Survival instinct",
   "start": 23.59,
   "end": 26.63
  },
  {
   "section": "Verse 1",
   "text": "No dey sleep for hand",
   "start": 26.63,
   "end": 28.89
  },
  {
   "section": "Verse 1",
   "text": "I learned too young",
   "start": 28.89,
   "end": 31.67
  },
  {
   "section": "Verse 1",
   "text": "How to read a face",
   "start": 31.67,
   "end": 34.23
  },
  {
   "section": "Verse 1",
   "text": "One cold goodbye",
   "start": 34.23,
   "end": 36.57
  },
  {
   "section": "Verse 1",
   "text": "And I move first place",
   "start": 36.57,
   "end": 39.51
  },
  {
   "section": "Pre-Chorus",
   "text": "Love fit become prison",
   "start": 39.51,
   "end": 41.97
  },
  {
   "section": "Pre-Chorus",
   "text": "If I miss the sign",
   "start": 41.97,
   "end": 43.41
  },
  {
   "section": "Pre-Chorus",
   "text": "I lock one eye open",
   "start": 43.41,
   "end": 47.27
  },
  {
   "section": "Pre-Chorus",
   "text": "Even when you fine",
   "start": 47.27,
   "end": 48.63
  },
  {
   "section": "Pre-Chorus",
   "text": "I want to stay",
   "start": 50.83,
   "end": 52.57
  },
  {
   "section": "Pre-Chorus",
   "text": "But my chest dey race",
   "start": 52.75,
   "end": 53.91
  },
  {
   "section": "Pre-Chorus",
   "text": "Like somebody knock",
   "start": 53.91,
