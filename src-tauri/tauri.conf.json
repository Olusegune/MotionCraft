{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MotionCraft",
  "version": "0.1.6",
  "identifier": "com.motioncraft.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MotionCraft",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 660,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#181A1C",
        "visible": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: asset: http://asset.localhost",
        "font-src": "'self' data:",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'self'",
        "form-action": "'none'",
        "frame-ancestors": "'none'",
        "media-src": "'self' asset: http://asset.localhost"
      },
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$DOCUMENT/MotionCraft/**"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDM0E1QjgyN0Y4OEYwMDIKUldRQzhJaC9nbHM2N0xHczRNZ3c3S1JnKzhjNUZBYXhEV0ZVTnpBV1dzVnJUcFVOWDgzK1NtSHoK",
      "endpoints": ["https://github.com/Olusegune/MotionCraft/releases/latest/download/latest.json"],
      "windows": { "installMode": "passive" }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../THIRD_PARTY_NOTICES/*": "THIRD_PARTY_NOTICES/",
      "../docs/*.md": "docs/"
    },
    "category": "Video",
    "shortDescription": "Direct motion design: brief to delivery.",
    "publisher": "MotionCraft",
    "copyright": "Copyright (c) 2026 MotionCraft. All rights reserved.",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      },
      "wix": {}
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "dmg": { "windowSize": { "width": 660, "height": 400 } }
    },
    "externalBin": [
      "binaries/motioncraft-engine"
    ]
  }
}
